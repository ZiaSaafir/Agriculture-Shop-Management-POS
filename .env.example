# Copy this file to .env and replace the example values for your machine.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://agriculture_pos_user:replace-with-your-password@127.0.0.1:5432/agriculture_pos
DB_CONN_MAX_AGE=60
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173
# Configure these from a Google OAuth web application before connecting Drive.
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:8000/api/backups/google/callback/
TIME_ZONE=Asia/Karachi
